# Plantilla de la configuración privada del correo.
# Cópiala como ".env" en la carpeta del proyecto y rellénala:
#     cp .env.ejemplo .env
# El fichero .env NO se sube a git (está en .gitignore): cópialo a mano a
# cada ordenador. Formato: CLAVE=valor, sin espacios alrededor del "=".

SERVIDOR_SMTP=smtp-relay.brevo.com
# 465 con SEGURIDAD=ssl, o 587 con SEGURIDAD=tls (STARTTLS)
PUERTO_SMTP=465
SEGURIDAD=ssl
# El "Login" de Brevo (SMTP & API -> SMTP), algo como 123abc@smtp-brevo.com
USUARIO_SMTP=
# La "clave SMTP" generada en Brevo
CONTRASENA_SMTP=
# Remitente verificado en Brevo y nombre que verá el destinatario
REMITENTE=
NOMBRE_REMITENTE=Patitas Felices
# Destinatarios cuando se usa -e sin dirección; varios separados por comas
DESTINATARIOS=
